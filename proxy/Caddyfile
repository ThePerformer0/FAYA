{$DOMAIN_NAME:localhost} {
    encode gzip zstd

    # API REST Django
    handle /api/* {
        reverse_proxy api:8000
    }

    # Django Admin (Back-office MVP)
    handle /admin/* {
        reverse_proxy api:8000
    }

    # Fichiers statiques Django Admin
    handle_path /static/* {
        root * /srv/static
        file_server
    }

    # Application PWA React (SPA fallback)
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
