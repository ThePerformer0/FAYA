# === Django ===
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_TIME_ZONE=Africa/Douala

# === Base de données (PostgreSQL / PostGIS) ===
POSTGRES_DB=faya
POSTGRES_USER=faya
POSTGRES_PASSWORD=faya_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Mettre à True dès que PostGIS est installé (obligatoire à partir du Jalon 1)
USE_POSTGIS=True
# Optionnel sous Windows si GDAL/GEOS ne sont pas dans le chemin standard PostgreSQL
# GDAL_LIBRARY_PATH=C:\Program Files\PostgreSQL\16\bin\libgdal-35.dll
# GEOS_LIBRARY_PATH=C:\Program Files\PostgreSQL\16\bin\libgeos_c.dll

# === JWT & Cookies ===
JWT_ACCESS_TOKEN_MINUTES=10
JWT_REFRESH_TOKEN_DAYS=14
AUTH_COOKIE_SECURE=False

# === Stockage Objet S3 / MinIO (local) / R2 (prod) ===
MINIO_ROOT_USER=faya_minio
MINIO_ROOT_PASSWORD=faya_minio_password
S3_BUCKET_NAME=faya-media
S3_ENDPOINT_URL=http://minio:9000

# === Production (Caddy) ===
DOMAIN_NAME=localhost
